<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FoxMelee</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data/transitions.json" LogicalName="transitions.json" />
    <EmbeddedResource Include="Data/waypoints.json" LogicalName="waypoints.json" />
    <EmbeddedResource Include="Data/macros.json" LogicalName="macros.json" />
    <EmbeddedResource Include="Data/locations.json" LogicalName="locations.json" />
  </ItemGroup>
</Project>
